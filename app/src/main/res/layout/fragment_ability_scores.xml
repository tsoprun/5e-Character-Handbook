<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".fragment.AbilityScoresFragment">

   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:padding="@dimen/_16dp">

       <TextView
           style="@style/SectionHeader"
           android:text="@string/ability_scores"
           android:textSize="@dimen/_30dp"/>
       <View style="@style/SectionDivider"/>

       <androidx.recyclerview.widget.RecyclerView
           android:layout_marginTop="@dimen/_10dp"
           android:id="@+id/rvAbilities"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:background="@drawable/bg_tile_dark"
           android:padding="@dimen/_10dp"
           android:clipToPadding="false"
           tools:listitem="@layout/item_ability_score" />

   </LinearLayout>

</FrameLayout>
